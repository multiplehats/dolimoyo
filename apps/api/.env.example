# .env.example — committed template documenting required env vars.
# Real values live in apps/api/.env (encrypted by dotenvx).
# Decryption key: apps/api/.env.keys (NEVER commit).

# Non-secret defaults (mirrored as wrangler `vars` in wrangler.jsonc).
FROM_EMAIL="digest@uitagenda.dev"
FROM_NAME="uitagenda"

# Secrets — populate via:
#   cd apps/api && pnpm exec dotenvx set <KEY> <value>
OPENROUTER_API_KEY=""
PARSEW_API_KEY=""
# AutoSend transactional email for digests.
AUTOSEND_API_KEY=""
